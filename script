def eda_outliers_table(df):
    """Detección de outliers como DataFrame"""
    print("\n" + "="*50)
    print("⚠️ ANÁLISIS DE OUTLIERS")
    print("="*50)

    outliers_info = []

    for col in ['social_min', 'rest_min', 'Puntaje']:
        Q1 = df[col].quantile(0.25)
        Q3 = df[col].quantile(0.75)
        IQR = Q3 - Q1
        lower = Q1 - 1.5 * IQR
        upper = Q3 + 1.5 * IQR

        outliers = df[(df[col] < lower) | (df[col] > upper)]

        outliers_info.append({
            'Variable': col,
            'Q1': Q1,
            'Q3': Q3,
            'IQR': IQR,
            'Límite_Inf': lower,
            'Límite_Sup': upper,
            'N_Outliers': len(outliers)
        })

    outliers_df = pd.DataFrame(outliers_info)
    print(outliers_df.round(1).to_string(index=False))

    return outliers_df

