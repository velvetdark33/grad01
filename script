### **Estructura del Dataset Original**

El dataset contiene **249 columnas** distribuidas así:

- **ID**: Identificador único del estudiante (anonimizado)
- **Sexo**: Género del estudiante (categórica)
- **Curso**: Curso académico (0-3, numérica)
- **Columnas 4-242**: Tiempo dedicado a cada aplicación específica (min/día)
- **Columnas 243-248**: Puntajes por área ICFES (0-100 puntos c/u)
- **Columna 249**: Puntaje total ICFES (0-500 puntos)

### **Transformaciones Aplicadas**

1. **Codificación de variables categóricas**: Sexo → binario (0/1)
2. **Agregación de variables**: Apps individuales → tiempo total diario
3. **Eliminación de redundancias**: Mantener solo variables predictoras esenciales
4. **Validación de calidad**: Verificar completitud y consistencia

**Imports, semilla y utilidades**
"""

# ==== HIPER8 (REPARADO) - BLOQUE 1: imports y setup ====
import io, re, requests, warnings
import numpy as np
import pandas as pd

from sklearn.model_selection import StratifiedKFold, cross_val_score
from sklearn.pipeline import Pipeline
from sklearn.compose import ColumnTransformer
from sklearn.preprocessing import StandardScaler, OneHotEncoder
from sklearn.linear_model import LogisticRegression, LogisticRegressionCV
from sklearn.dummy import DummyClassifier

warnings.filterwarnings("ignore")
import numpy as np, random
SEED = 42
np.random.seed(SEED); random.seed(SEED)

pd.set_option("display.precision", 3)

print("OK: entorno listo (SEED=42)")

"""**Carga y preparación de datos**"""

# ==== HIPER8 (REPARADO) - BLOQUE 2: datos ====
URL = "https://raw.githubusercontent.com/velvetdark33/grad01/main/datfeb10.csv"

def load_and_prep_data(url=URL):
    df = pd.read_csv(io.StringIO(requests.get(url, timeout=30).text))

    # Ingeniería esencial (igual idea que hiper8)
    app_cols = df.columns[3:-6]  # columnas de apps
    social_cols = [c for c in app_cols if re.search(r'(instagram|whatsapp|facebook)', str(c), re.I)]

    df["social_min"] = df[social_cols].fillna(0).sum(axis=1) if social_cols else 0
    df["rest_min"]   = df[app_cols].fillna(0).sum(axis=1) - df["social_min"]

    # Sexo a binario
    if df["Sexo"].dtype == "object":
        df["Sexo"] = df["Sexo"].map({"female":0,"femenino":0,"male":1,"masculino":1}).fillna(0).astype(int)

    # Etiqueta en terciles de Puntaje
    df["y"] = pd.qcut(df["Puntaje"], q=3, labels=[0,1,2]).astype(int)

    cols = ["Curso","Sexo","social_min","rest_min","y"]
    return df[cols].copy(), df  # (Xy minimal, df completo por si lo quieres ver)

df, df_full = load_and_prep_data()
print("✅ df listo:", df.shape)
display(df.head(3))

"""**Modelos comparativos (dummy, demográfico, full y full_bal)**"""

# ==== HIPER8 (REPARADO) - BLOQUE 3: modelos ====
X = df.drop(columns=["y"])
y = df["y"]

# Preprocesamiento del modelo "full"
preproc = ColumnTransformer([
    ("num", StandardScaler(), ["social_min","rest_min"]),
    ("cat", OneHotEncoder(drop="first", handle_unknown="ignore"), ["Curso","Sexo"])  # FIX: ignore
])

# Versiones base como en HIPER8:
models = {
    "dummy": DummyClassifier(strategy="stratified", random_state=SEED),
    "demographic": Pipeline([
        ("prep", ColumnTransformer([
            ("cat", OneHotEncoder(drop="first", handle_unknown="ignore"), ["Curso","Sexo"])  # FIX
        ])),
        ("clf", LogisticRegressionCV(cv=3, max_iter=1000, random_state=SEED))
    ]),
    "full": Pipeline([
        ("prep", preproc),
        ("clf", LogisticRegressionCV(
        cv=StratifiedKFold(n_splits=3, shuffle=True, random_state=SEED),
        max_iter=2000, random_state=SEED, multi_class="multinomial", solver="lbfgs"
))

    ]),
    # NEW: variante balanceada (misma estructura, un único cambio)
    "full_bal": Pipeline([
        ("prep", preproc),
        ("clf", LogisticRegressionCV(cv=3, max_iter=2000, random_state=SEED,
                                     multi_class="multinomial", solver="lbfgs",
                                     class_weight="balanced"))
    ]),
}

# Validación 5-fold (idéntica estructura)
cv5 = StratifiedKFold(n_splits=5, shuffle=True, random_state=SEED)

rows = []
for name, mdl in models.items():
    # 'demographic' usa solo Curso/Sexo; 'full' y 'full_bal' usan las 4 vars
    if name == "demographic":
        X_in = X[["Curso","Sexo"]]
    elif name in ("full", "full_bal"):
        X_in = X[["Curso","Sexo","social_min","rest_min"]]
    else:
        X_in = X
        cv5 = StratifiedKFold(n_splits=5, shuffle=True, random_state=SEED)
