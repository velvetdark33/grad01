def eda_insights_table(df):
    """Insights automáticos como DataFrame"""
    print("\n" + "="*50)
    print("💡 INSIGHTS CLAVE")
    print("="*50)

    insights = []

    # Tiempo promedio
    total_min = df['social_min'].mean() + df['rest_min'].mean()
    insights.append({
        'Insight': 'Uso diario promedio',
        'Valor': f"{total_min:.0f} min ({total_min/60:.1f} horas)",
        'Detalle': f"Social: {df['social_min'].mean()/total_min*100:.0f}%, No-social: {df['rest_min'].mean()/total_min*100:.0f}%"
    })

    # Mejor predictor
    corr_abs = df[['Curso', 'Sexo', 'social_min', 'rest_min']].corrwith(df['Puntaje']).abs()
    best = corr_abs.idxmax()
    insights.append({
        'Insight': 'Mejor predictor',
        'Valor': best,
        'Detalle': f"Correlación: {corr_abs[best]:.3f}"
    })

    # ANOVA Curso
    groups = [df[df['Curso'] == i]['Puntaje'] for i in df['Curso'].unique()]
    f_stat, p_val = stats.f_oneway(*groups)
    insights.append({
        'Insight': 'ANOVA Curso',
        'Valor': f"F={f_stat:.2f}",
        'Detalle': f"p-valor={p_val:.4f} {'(Significativo)' if p_val < 0.05 else '(No sig.)'}"
    })

    # Rango de puntajes
    insights.append({
        'Insight': 'Rango puntajes',
        'Valor': f"{df['Puntaje'].min():.0f} - {df['Puntaje'].max():.0f}",
        'Detalle': f"Amplitud: {df['Puntaje'].max() - df['Puntaje'].min():.0f} puntos"
    })

    insights_df = pd.DataFrame(insights)
    print(insights_df.to_string(index=False))

    return insights_df

