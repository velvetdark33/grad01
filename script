def _boxplot_by_group(data, var, fname, title):
    fig, ax = plt.subplots(figsize=(7,5))
    if _use_sns:
        sns.boxplot(data=data, x='Rendimiento', y=var, order=order_labels,
                    color="#e57373", ax=ax)
    else:
        vals = [data.loc[data['Rendimiento']==g, var].dropna().values for g in order_labels]
        ax.boxplot(vals, labels=order_labels, patch_artist=True)

    ax.set_title(title, fontsize=16, fontweight='bold')
    ax.set_xlabel("Nivel de Rendimiento Académico")
    ax.set_ylabel("Tiempo Promedio (minutos/día)")
    ax.grid(axis='y', linestyle='--', alpha=0.35)

    # Anotar medianas
    for i, g in enumerate(order_labels):
        med = data.loc[data['Rendimiento']==g, var].median()
        if np.isfinite(med):
            ax.text(i, med, f"Med: {int(round(med))}",
                    ha='center', va='bottom', fontsize=12, fontweight='bold')

    plt.tight_layout()
    plt.savefig(fname, dpi=300, bbox_inches="tight")
    plt.show()
    print(f"✅ Guardado: {fname}")

