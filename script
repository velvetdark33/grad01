def load_and_prep(url='https://raw.githubusercontent.com/velvetdark33/grad01/main/datfeb10.csv'):
    """Carga y preprocesa datos con corrección de tipos"""
    df = pd.read_csv(url)

    # Convertir Sexo a numérico si es texto
    if df['Sexo'].dtype == 'object':
        df['Sexo'] = df['Sexo'].map({'female': 0, 'femenino': 0, 'male': 1, 'masculino': 1})
        df['Sexo'] = df['Sexo'].fillna(0).astype(int)

    # Feature engineering corregido
    app_cols0 = df.columns[3:-6]
    social_apps = [c for c in app_cols0 if re.search(r'(instagram|whatsapp|facebook)', str(c), re.I)]
    available_social = [col for col in social_apps if col in df.columns]

    # Calcular minutos sociales
    df['social_min'] = df[available_social].fillna(0).sum(axis=1)

    # Calcular resto de minutos (excluyendo ID, Sexo, Curso, Puntaje)
    numeric_cols = df.select_dtypes(include=[np.number]).columns
    exclude_cols = ['ID', 'Sexo', 'Curso', 'Puntaje', 'social_min']
    rest_cols = [col for col in numeric_cols if col not in exclude_cols and col not in available_social]
    df['rest_min'] = df[rest_cols].fillna(0).sum(axis=1)

    # Categorizar rendimiento
    df['y'] = pd.qcut(df['Puntaje'], q=3, labels=[0, 1, 2]).astype(int)

    # Limpiar valores extremos (opcional)
    df['social_min'] = np.clip(df['social_min'], 0, 1440)
    df['rest_min'] = np.clip(df['rest_min'], 0, 1440)

    return df[['ID', 'Sexo', 'Curso', 'social_min', 'rest_min', 'Puntaje', 'y']]

def eda_stats_tables(df):
    """Estadísticas descriptivas como DataFrames"""
    print("\n" + "="*50)
    print("📊 ESTADÍSTICAS DESCRIPTIVAS - TABLAS")
    print("="*50)

    # Info básica
    info_df = pd.DataFrame({
        'Métrica': ['Total estudiantes', 'Variables', 'Missing values', 'Horas promedio uso'],
        'Valor': [len(df), df.shape[1], df.isnull().sum().sum(),
                 f"{(df['social_min'].mean() + df['rest_min'].mean())/60:.1f}"]
    })
    print("\n📋 INFORMACIÓN GENERAL:")
    print(info_df.to_string(index=False))

    # Estadísticas numéricas
    print("\n📈 VARIABLES NUMÉRICAS:")
    stats_df = df[['social_min', 'rest_min', 'Puntaje']].describe().T
    stats_df = stats_df[['count', 'mean', 'std', 'min', '25%', '50%', '75%', 'max']]
    stats_df.columns = ['N', 'Media', 'DE', 'Min', 'Q1', 'Mediana', 'Q3', 'Max']
    print(stats_df.round(1))

    # Distribución categóricas
    print("\n📊 VARIABLES CATEGÓRICAS:")
    cat_df = pd.DataFrame({
        'Variable': ['Sexo', 'Curso', 'Rendimiento'],
        'Distribución': [
            f"F:{(df['Sexo']==0).sum()} M:{(df['Sexo']==1).sum()}",
            df['Curso'].value_counts().sort_index().to_dict(),
            f"Bajo:{(df['y']==0).sum()} Medio:{(df['y']==1).sum()} Alto:{(df['y']==2).sum()}"
        ]
    })
    print(cat_df.to_string(index=False))

    return info_df, stats_df, cat_df

def eda_correlations_table(df):
    """Análisis de correlaciones como DataFrame"""
    print("\n" + "="*50)
    print("🔗 ANÁLISIS DE CORRELACIONES")
    print("="*50)

    # Calcular correlaciones
    corr_vars = ['Curso', 'Sexo', 'social_min', 'rest_min']
    correlations = []

    for var in corr_vars:
        r, p = stats.pearsonr(df[var].fillna(0), df['Puntaje'])
        correlations.append({
            'Variable': var,
            'Correlación': r,
            'P-valor': p,
            'Significativo': '✓' if p < 0.05 else '✗'
        })

    corr_df = pd.DataFrame(correlations).sort_values('Correlación', ascending=False, key=abs)
    print("\n📊 CORRELACIONES CON PUNTAJE:")
    print(corr_df.to_string(index=False))

    # Matriz de correlación completa
    print("\n📈 MATRIZ DE CORRELACIÓN:")
    corr_matrix = df[corr_vars + ['Puntaje']].corr()
    print(corr_matrix.round(3))

    return corr_df, corr_matrix

