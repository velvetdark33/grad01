import numpy as np, pandas as pd, matplotlib.pyplot as plt

def _confidence_score(est, X):
    # Usa predict_proba si existe; si no, usa decision_function como proxy
    if hasattr(est, "predict_proba"):
        proba = est.predict_proba(X)
        return float(np.mean(np.max(proba, axis=1)))
    elif hasattr(est, "decision_function"):
        dec = est.decision_function(X)
        dec = np.asarray(dec)
        # multi-clase: tomamos el margen máximo; binaria 1D: magnitud
        if dec.ndim == 2:
            return float(np.mean(np.max(dec, axis=1)))
        else:
            return float(np.mean(np.abs(dec)))
    else:
        # fallback: consistencia de predicción (proporción del modo de predicciones)
        pred = est.predict(X)
        vals, counts = np.unique(pred, return_counts=True)
        return float(counts.max() / len(pred))

def permutation_importance_confidence(est, X, n_repeats=20, random_state=SEED):
    rng = np.random.RandomState(random_state)
    X = X.copy()
    cols = list(X.columns) if hasattr(X, "columns") else list(range(X.shape[1]))
    baseline = _confidence_score(est, X)
    R, J = n_repeats, X.shape[1]
    drops = np.zeros((R, J), dtype=float)

    for r in range(R):
        for j in range(J):
            Xp = X.copy()
            # permutar columna j preservando distribución
            if hasattr(Xp, "iloc"):
                col = Xp.iloc[:, j].values
                rng.shuffle(col)
                Xp.iloc[:, j] = col
            else:
                col = Xp[:, j].copy()
                rng.shuffle(col)
                Xp[:, j] = col
            score_p = _confidence_score(est, Xp)
            drops[r, j] = baseline - score_p

    imp_mean = drops.mean(axis=0)
    imp_std  = drops.std(axis=0)
    return pd.DataFrame({
        "Variable": cols,
        "PI_conf_mean": imp_mean,
        "PI_conf_std":  imp_std
    }).sort_values("PI_conf_mean", ascending=False)

