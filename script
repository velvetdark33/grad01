def load_and_prep_data(filepath='datfeb10.csv'):
    """
    Carga los datos, procesa columnas de tiempo y crea la variable objetivo 'y'.
    """
    df = pd.read_csv(filepath)

    # Heurística para identificar columnas de apps
    app_cols = df.columns[3:-6]
    pat_social = re.compile(r'(tiktok|instagram|whatsapp|facebook|x|telegram)', re.I)

    social_cols = [col for col in app_cols if pat_social.search(col)]
    non_social_cols = [col for col in app_cols if not pat_social.search(col)]

    # Calcular minutos totales
    df['social_min'] = df[social_cols].sum(axis=1)
    df['rest_min'] = df[non_social_cols].sum(axis=1)

    # Crear variable objetivo 'y' (Rendimiento)
    # **PUNTO CRÍTICO**: Asegúrate de que la columna de puntaje es 'PUNT_GLOBAL'
    puntaje_col = 'Puntaje'

    # Definir los cuantiles para los 3 grupos
    q_low = df[puntaje_col].quantile(0.33)
    q_high = df[puntaje_col].quantile(0.66)

    df['y'] = pd.cut(df[puntaje_col],
                     bins=[-np.inf, q_low, q_high, np.inf],
                     labels=['Bajo', 'Medio', 'Alto'])

    return df

