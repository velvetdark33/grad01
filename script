def add_shap_analysis(X, model):
    """
    SHAP multinomial robusto sin DataFrames ni index por nombre.
    Devuelve: shap_list, X_plot, feat_names, classes, shap_importance
    """
    print("\n🔬 Ejecutando análisis SHAP...")

    preproc = model.named_steps['prep']
    clf     = model.named_steps['clf']

    # 1) Transformación y matriz densa
    Xt = preproc.transform(X)
    X_plot = Xt.toarray() if hasattr(Xt, "toarray") else np.asarray(Xt)

    # 2) Nombres y tamaños DIRECTOS desde OneHotEncoder
    enc = preproc.named_transformers_['cat']  # OneHotEncoder(drop='first')
    n_curso = len(enc.categories_[0])         # total categorías Curso
    n_sexo  = len(enc.categories_[1])         # total categorías Sexo
    # Orden en ColumnTransformer: num(['social_min','rest_min']) -> 2, luego cat (Curso sin base, Sexo sin base)
    cat_names = [f"cat__Curso_{c}" for c in enc.categories_[0][1:]] + \
                [f"cat__Sexo_{c}"  for c in enc.categories_[1][1:]]
    feat_names = np.array(['num__social_min','num__rest_min'] + cat_names)

    # Blindaje por si la longitud no coincide (no rompemos, usamos genéricos)
    n_feat = X_plot.shape[1]
    if len(feat_names) != n_feat:
        feat_names = np.array([f"feat_{i}" for i in range(n_feat)])

    # 3) Explainer y valores SHAP por clase (lista)
    explainer = shap.LinearExplainer(clf, X_plot)
    sv = explainer.shap_values(X_plot)
    shap_list = sv if isinstance(sv, list) else [sv]
    classes   = clf.classes_

    # 4) Resumen para clase 'Bajo' (0)
    i_bajo    = int(np.where(classes == 0)[0][0])
    svals_bajo = np.asarray(shap_list[i_bajo])  # (n_muestras, n_feat)

    print("✨ Generando gráfico de resumen SHAP...")
    shap.summary_plot(svals_bajo, X_plot, feature_names=feat_names, show=False)
    # --- Guardado limpio como Figura 4.2 ---
    plt.tight_layout()
    plt.subplots_adjust(left=0.35)   # evita recorte de nombres largos
    plt.savefig("figura_4_2_shap.png", dpi=300, bbox_inches="tight")
    plt.show()
    print("✅ Guardado: figura_4_2_shap.png")

    plt.subplots_adjust(left=0.35)  # da más espacio para nombres largos
    plt.savefig("figura_shap_bajo.png", dpi=300, bbox_inches="tight")
    plt.show()
    plt.title("Resumen SHAP — clase 'Bajo' (modelo full_bal)", fontsize=14)
    plt.xlabel("Impacto en la predicción del modelo (valor SHAP)", fontsize=12)
    plt.tight_layout()
    plt.savefig('figura_shap_bajo_rendimiento.png', dpi=300, bbox_inches='tight')
    plt.close()
    print("✅ Gráfico guardado como 'figura_shap_bajo_rendimiento.png'.")

    # 5) Importancia promedio absoluta (agrupada por índices, sin pandas)
    imp_abs = np.mean(np.abs(svals_bajo), axis=0).ravel()  # (n_feat,)

    # Índices de grupos (coinciden con el orden del CT):
    # 0 -> social_min, 1 -> rest_min, luego Curso (n_curso-1), luego Sexo (n_sexo-1)
    g_social = float(imp_abs[0])
    g_rest   = float(imp_abs[1])
    start    = 2
    g_curso  = float(imp_abs[start : start + (n_curso-1)].sum()) if (start + (n_curso-1)) <= n_feat else 0.0
    g_sexo   = float(imp_abs[start + (n_curso-1) : start + (n_curso-1) + (n_sexo-1)].sum()) \
               if (start + (n_curso-1)) < n_feat else 0.0

    shap_importance = {
        'Apps_No_Sociales': g_rest,
        'Apps_Sociales':    g_social,
        'Curso':            g_curso,
        'Sexo':             g_sexo,
    }

    print("\n🔍 ANÁLISIS SHAP - IMPORTANCIA PROMEDIO (VALOR ABSOLUTO):")
    for k, v in sorted(shap_importance.items(), key=lambda x: x[1], reverse=True):
        print(f"   {k}: {v:.4f}")

    return shap_list, X_plot, feat_names, classes, shap_importance



